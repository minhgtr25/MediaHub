{
  "name": "mediahub-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.mts",
    "build": "tsc",
    "start": "node dist/server.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,mts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,mts}\"",
    "db:check": "npm run build && node scripts/check-migrations.mjs",
    "db:audit": "npm run build && node scripts/schema-inventory.mjs",
    "db:migrate": "npm run build && node scripts/migrate.mjs --apply",
    "db:seed-demo": "npm run build && node scripts/seed-demo.mjs --apply",
    "db:test-accounts": "npm run build && node scripts/provision-test-accounts.mjs --apply",
    "db:verify-test-accounts": "npm run build && node scripts/verify-test-accounts.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0"
  }
}
